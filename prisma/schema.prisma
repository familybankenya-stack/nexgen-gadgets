generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  brand        String
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  price        Int
  comparePrice Int?
  discountPct  Int?
  images       String[]
  rating       Float    @default(4.5)
  reviews      Int      @default(0)
  condition    String   @default("New")
  inStock      Boolean  @default(true)
  description  String
  specs        Json
  createdAt    DateTime @default(now())
}
